{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VS Code Profile Manifest",
  "type": "object",
  "required": ["profile"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "profile": {"type": "string", "minLength": 1},
    "variant": {"type": "string", "enum": ["code", "insiders", "codium", "custom"], "default": "code"},
    "codeBin": {"type": "string", "description": "Override the VS Code CLI binary/path."},
    "workspace": {"type": "string", "description": "Folder/workspace to open when creating or activating the profile."},
    "profileId": {"type": "string", "description": "Internal profile ID/folder name, if known."},
    "settingsFile": {"type": "string", "description": "Explicit settings.json path, if known."},
    "settings": {"type": "object", "additionalProperties": true},
    "removeSettings": {"type": "array", "items": {"type": "string"}},
    "extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "removeExtensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "keybindings": {"type": "array", "items": {"type": "object"}},
    "snippets": {"type": "object", "additionalProperties": true},
    "tasks": {"type": "object", "additionalProperties": true},
    "notes": {"type": "string"}
  }
}
